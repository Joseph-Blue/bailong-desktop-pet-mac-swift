"aboutPage.creditsText.heading.5" = "动画播放";
"aboutPage.creditsText.paragraph.6" = "使用 macOS 自带的动画播放与图像处理功能，让角色周围保持透明。动画文件采用 Apple 的透明 HEVC 格式。";
"aboutPage.creditsText.text.2" = "Apple 透明 HEVC 说明";
"aboutPage.creditsText.heading.6" = "SQLite · 对话记录";
"aboutPage.creditsText.paragraph.7" = "使用 macOS 自带的 SQLite 保存本机对话记录、读取 Codex 任务信息。SQLite 的代码和文档属于公有领域。";
"aboutPage.creditsText.text.3" = "SQLite 官方版权说明";
"aboutPage.creditsText.heading.7" = "macOS 界面设计参考 · macos-golden-gate-design";
"aboutPage.creditsText.paragraph.8" = "界面设计参考 gambadio 的 macos-golden-gate-design，让设置和窗口更贴近 Mac 的使用习惯。该设计指南采用 MIT 许可证。";
