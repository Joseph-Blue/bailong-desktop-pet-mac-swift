"aboutPage.creditsText.paragraph.3" = "感谢 ruyeli 在本仓库的英文版本地化分支中分享的 macOS SDK 兼容处理，为本项目改进构建脚本提供了参考。";
"aboutPage.creditsText.heading.3" = "动画优化参考 · moon135246";
"aboutPage.creditsText.paragraph.4" = "感谢 moon135246 基于我的白龙桌宠优化分支（原项目 Python + QT 技术栈，非本项目）继续改进，为本项目的动作缓存与性能优化提供了参考。";
"aboutPage.creditsText.heading.4" = "角色动画与应用图标";
